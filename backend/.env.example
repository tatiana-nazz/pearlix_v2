SECRET_KEY=dev-only-insecure-secret-key-for-local-development
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
TIME_ZONE=Asia/Damascus
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# Forwarded client IP headers are ignored unless the request's direct peer is
# inside one of these verified reverse-proxy CIDRs. Leave empty by default;
# add only CIDRs documented by the deployment's actual trusted proxy operator.
TRUSTED_PROXY_CIDRS=

# Optional shared authentication-security tuning. PostgreSQL remains the
# authoritative cross-instance store; these defaults bound refresh abuse and
# opportunistic cleanup/retention work.
AUTH_REFRESH_IDENTIFIER_THROTTLE_RATE=30/min
AUTH_THROTTLE_CLEANUP_INTERVAL_SECONDS=60
AUTH_THROTTLE_CLEANUP_BATCH_SIZE=256
AUTH_SESSION_REVOKED_RETENTION_SECONDS=86400

# Required PostgreSQL local-development values. They are intentionally empty so
# an unedited copy fails closed. Set a unique URL-safe password in the ignored
# backend/.env and place the same value in its DATABASE_URL as documented.
PEARLIX_LOCAL_DB_PASSWORD=
DATABASE_URL=

# Settings selection is intentionally external to this file because Django must
# know which settings module to load before it can read .env. Pass
# --settings=config.settings.local to local management commands, and set
# DJANGO_SETTINGS_MODULE=config.settings.production on the deployment host.

# Production private media storage (Supabase Storage S3-compatible endpoint).
# These credentials are server-side secrets. Never expose them through VITE_* variables.
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET_NAME=
SUPABASE_S3_REGION=

# Future AI service integration.
AI_SERVICE_URL=
AI_SERVICE_TOKEN=

# Trusted local artifact locations for a future real inference adapter.
PEARLIX_AI_MODEL_ROOT=
PEARLIX_AI_DETECTOR_PATH=weights/detector_yolo_fdi_seg_v1-3_best.pt
PEARLIX_AI_CLASSIFIER_PATH=weights/classifier_exp1_epoch12.pt
PEARLIX_AI_FDI_MAP_PATH=contract/fdi_class_map.json
PEARLIX_AI_DEVICE=cpu
# Bound simultaneous model executions until deployment benchmarking is complete.
PEARLIX_AI_MAX_CONCURRENT_INFERENCES=1
# Test harness only. Keep disabled in ordinary local and production runtimes.
PEARLIX_ALLOW_MOCK_AI=false
# Demo commands use a code-owned fail-closed switch: enabled only by the
# checked-in local/test settings and forced off by production settings.
# Processing claims older than this may be recovered after worker interruption.
PEARLIX_AI_PROCESSING_STALE_SECONDS=900
